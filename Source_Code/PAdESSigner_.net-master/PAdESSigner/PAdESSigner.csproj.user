<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <StartArguments>-signType "single" -inputFile "T01/Input/INV101-2569.pdf" -outputFile "T01/Output/INV101-2569_Signed.pdf" -pkcs12FilePath "T01/Cert/dev11.p12" -pkcs12Password "123456" -timeStampType "COMPUTER_CLOCK" -Location "Bangkok" -Reason "To sign with PKCS12" -X 100 -Y 100 -Width 200 -Height 200 -SignatureFieldName "Test_SIG" -PageNumber 1 -SignatureLevel "APPROVAL" -SignatureVisibility "VISIBLE" -SignaturePattern "DESCRIPTION" -digestAlgorithm "SHA256"
</StartArguments>
  </PropertyGroup>
</Project>